# 复制为 .env 后填写。.env 不会被提交。

# Neon Postgres 连接串（pgvector 与业务表同库）
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# 会话 JWT 签名密钥。生成：openssl rand -base64 32
AUTH_SECRET=""

# 可选：用户自填 LLM「跨设备同步」时的 AES-GCM 加密密钥。
# 不配置时，API Key 只允许保存在浏览器本地（localStorage），服务端不落库。
# 生成：openssl rand -base64 32
# ENCRYPTION_KEY=""
